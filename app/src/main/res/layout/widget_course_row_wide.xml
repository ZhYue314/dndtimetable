<?xml version="1.0" encoding="utf-8"?>
<!-- 宽式课程条目（≥3 列宽小组件，图3 样式）：左侧色条 + 课程名/教室 老师，右侧两行时间段。
     根布局 height=0dp+weight=1：在列表容器内均分高度，尽量占满小组件面积。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- 颜色条：RemoteViews 白名单不允许裸 View，用 FrameLayout 承载背景色 -->
    <FrameLayout
        android:id="@+id/widget_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/widget_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="7dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_course_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/widget_course_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:orientation="vertical"
        android:gravity="end">

        <!-- 明天/最近有课日课程：时间前显示「明日」（强调色，同行；默认隐藏由代码切换） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_tomorrow_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginEnd="3dp"
                android:text="明日"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent" />

            <TextView
                android:id="@+id/widget_course_time_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_course_time_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
</LinearLayout>
